      "id": "1d675995-ba94-4804-808f-4ff8b4cc0202",
      "name": "Recibir periodo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        608,
        160
      ],
      "webhookId": "resumen-correos"
    },
    {
      "parameters": {
        "jsCode": "const correos = $input.all().map(item => item.json);\n\nconst webhook = $('Recibir periodo').first().json;\nconst periodo = webhook.body?.periodo || 'semana';\n\nif (correos.length === 0) {\n  return [\n    {\n      json: {\n        periodo,\n        cantidad: 0,\n        prompt: `No existen correos registrados para el periodo ${periodo}. Responde brevemente indicando que no hay correos disponibles para generar un resumen.`\n      }\n    }\n  ];\n}\n\nconst correosTexto = correos.map((correo, index) => {\n  return `\nCORREO ${index + 1}\nRemitente: ${correo.remitente || 'Desconocido'}\nEmail: ${correo.emailRemitente || 'No disponible'}\nAsunto: ${correo.asunto || 'Sin asunto'}\nFecha: ${correo.fecha || 'Sin fecha'}\nContenido: ${correo.contenido || 'Sin contenido'}\n-------------------------`;\n}).join('\\n');\n\nconst prompt = `\nEres un asistente encargado de analizar correos electrónicos.\n\nAnaliza los correos correspondientes al periodo: ${periodo}.\n\nCantidad de correos: ${correos.length}.\n\nGenera un resumen breve, claro y útil para el usuario.\n\nPrioriza:\n- tareas pendientes\n- fechas importantes\n- reuniones\n- entregas\n- solicitudes\n- compromisos\n- mensajes que requieran atención\n\nNo inventes información.\nNo agregues información que no aparezca en los correos.\nNo hagas un resumen correo por correo.\nGenera como máximo 2 o 3 párrafos.\n\nCORREOS:\n${correosTexto}\n`;\n\nreturn [\n  {\n    json: {\n      periodo,\n      cantidad: correos.length,\n      prompt\n    }\n  }\n];"
      },
      "id": "01e6a61e-faf7-473c-894f-9ba1a50ed267",
      "name": "Preparar correos para IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        160
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}"
      },
      "id": "8a601dd1-49ce-4c02-94bc-501ad7eaddf0",
      "name": "Generar resumen IA",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
